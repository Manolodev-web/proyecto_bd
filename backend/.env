PORT=4000

# -------------------------------------------------------------
# 1. POSTGRESQL
# -------------------------------------------------------------
# Puerto 5432 (Nativo Windows) | 5433 (Docker)
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=recoleccion_lp

# -------------------------------------------------------------
# 2. MYSQL
# -------------------------------------------------------------
# Puerto 3306 (Nativo Windows / XAMPP / Workbench) | 3307 (Docker)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=recoleccion_lp

# -------------------------------------------------------------
# 3. SQL SERVER
# -------------------------------------------------------------
# Puerto 1433 (Estándar local y Docker)
SQLSERVER_HOST=localhost
SQLSERVER_PORT=1433
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=TuPasswordSeguro123!
SQLSERVER_DATABASE=recoleccion_lp

# -------------------------------------------------------------
# 4. ORACLE DATABASE
# -------------------------------------------------------------
# Puerto 1521 (Oracle XE / FreePDB1 en Docker o Local)
ORACLE_USER=system
ORACLE_PASSWORD=oracle
ORACLE_CONNECT_STRING=localhost:1521/FREEPDB1